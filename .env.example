# Copy to .env and fill in. Never commit .env itself.
# Generate a key with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"

SECRET_KEY=replace-me
DEBUG=True

# --- PostgreSQL ---------------------------------------------------
# django-tenants requires PostgreSQL; each restaurant gets its own schema.
DB_NAME=saas_template
DB_USER=postgres
DB_PASSWORD=replace-me
DB_HOST=localhost
DB_PORT=5432

# --- Hosts --------------------------------------------------------
# Tenants live on subdomains, so include the leading-dot wildcard.
# Dev:  localhost,127.0.0.1,.localhost
# Prod: .yourdomain.com
ALLOWED_HOSTS=localhost,127.0.0.1,.localhost

# --- Platform admin -----------------------------------------------
# Shared secret for the tenant-management API on the bare domain.
# Blank in dev (the API is open while DEBUG=True). REQUIRED in production --
# config/settings/production.py refuses to boot without it.
# Send it as the X-Platform-Token header.
PLATFORM_ADMIN_TOKEN=
